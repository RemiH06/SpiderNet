# Copia este directorio a sites/<tu-red>/ (gitignorado), renombra este
# archivo a dns.env y llena los valores reales. Datos de ejemplo ficticios.

# IP fija de esta Pi en la LAN, fuera del rango del DHCP del router.
SPIDERNET_LAN_IP=10.20.30.10

# Panel web, solo en 127.0.0.1 (se publica con `tailscale serve`).
SPIDERNET_ADMIN_PORT=8053
SPIDERNET_ADMIN_USER=admin

# Hash bcrypt, entre comillas simples (lleva $). Generarlo con:
#   htpasswd -B -C 10 -n -b admin 'tu-contraseña' | cut -d: -f2
# o, sin apache2-utils:
#   uv run --with bcrypt python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt(10)).decode())"
SPIDERNET_ADMIN_PASSWORD_HASH='$2y$10$CAMBIAR_ESTO'
